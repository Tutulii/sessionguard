# Web and security
HOST=0.0.0.0
PORT=8787
APP_ORIGIN=https://sessionguard.example
LOG_LEVEL=info
SESSION_MASTER_KEY=replace-with-at-least-32-random-characters
DECISION_SIGNING_KEY=replace-with-a-different-32-character-random-secret
ADMIN_TOKEN=replace-with-a-long-random-operations-token
METRICS_TOKEN=replace-with-a-separate-observability-token
PUBLIC_BETA_USER_CAP=500

# Fly Managed PostgreSQL and Redis
DATABASE_URL=postgres://user:password@private-host:5432/sessionguard
DATABASE_SSL=0
REDIS_URL=rediss://default:password@redis-host:6379

# Managed KMS envelope encryption
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KMS_KEY_ID=arn:aws:kms:ap-southeast-1:000000000000:key/replace-me

# Alert providers
RESEND_API_KEY=
EMAIL_FROM=SessionGuard <alerts@example.com>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=SessionGuardBot
TELEGRAM_WEBHOOK_SECRET=
VAPID_SUBJECT=mailto:security@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Observability
SENTRY_DSN=
VITE_SENTRY_DSN=
OTEL_SERVICE_NAME=sessionguard
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Event-driven Qwen analyst (server-only; never prefix these with VITE_)
AGENT_RUNTIME_ENABLED=0
QWEN_API_KEY=
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_MODEL=qwen3.8-max
QWEN_PROMPT_VERSION=sessionguard-agent-v1
SEC_USER_AGENT=SessionGuard/1.0 contact@example.com

# Local/test only; never enable in the public deployment
SESSIONGUARD_ALLOW_LOCAL_INFRA=0
PLATFORM_DATABASE_PATH=.data/sessionguard-platform.sqlite
LOCAL_KMS_MASTER_KEY=local-only-key-at-least-32-characters
