{
  "name": "sessionguard",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web,worker -c yellow,cyan,green \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --host 0.0.0.0\" \"tsx watch --env-file-if-exists=.env server/worker-entry.ts\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node --import ./dist-server/server/instrumentation.js dist-server/server/index.js",
    "start:web": "NODE_ENV=production node --import ./dist-server/server/instrumentation.js dist-server/server/index.js",
    "start:worker": "NODE_ENV=production node --import ./dist-server/server/instrumentation.js dist-server/server/worker-entry.js",
    "migrate": "node dist-server/server/migrate.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "security:secrets": "node scripts/secret-scan.mjs",
    "security:agent-execution": "node scripts/agent-execution-scan.mjs",
    "security:dependencies": "npm audit --audit-level=high",
    "synthetic:smoke": "node scripts/synthetic-smoke.mjs",
    "check": "npm run typecheck && npm run test && npm run security:secrets && npm run security:agent-execution && npm run security:dependencies && npm run build",
    "dev:worker": "tsx watch --env-file-if-exists=.env server/worker-entry.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1128.0",
    "@bitget-ai/bitget-agent-sdk": "^3.3.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@fontsource/fraunces": "^5.2.8",
    "@fontsource/instrument-sans": "^5.2.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@sentry/node": "^10.73.0",
    "@sentry/react": "^10.73.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "ethers": "^6.17.0",
    "fast-xml-parser": "^5.2.5",
    "fastify": "^5.6.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.544.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "redis": "^6.2.1",
    "siwe": "^3.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^5.0.0"
  }
}
